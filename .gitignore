# --- secrets / local env ---
.env
*.pem
*.key

# --- terraform ---
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
terraform.tfvars
!terraform.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# --- python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
build/
dist/

# --- dbt ---
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml
profiles.yml

# --- airflow ---
airflow/logs/
airflow/airflow.db
airflow/airflow.cfg
airflow/webserver_config.py
airflow/standalone_admin_password.txt

# --- local data lake (dev runs write here) ---
# The directory itself is tracked (via .gitkeep) so docker-compose's bind mount
# finds it instead of creating a root-owned one the airflow user cannot write.
data-lake/*
!data-lake/.gitkeep

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
