# Copy to .env and fill in real values for local development.
# Never commit a real .env file (see .gitignore).

# ---------------------------------------------------------------------------
# Metadata store (Postgres) — libs/metadata_client, metadata-api, dbt's
# local-dev "warehouse" target all point here.
# ---------------------------------------------------------------------------
METADATA_DATABASE_URL=postgresql+psycopg2://quarry_admin:quarry_dev_password@localhost:5432/quarry_metadata
WAREHOUSE_DATABASE_URL=postgresql+psycopg2://quarry_admin:quarry_dev_password@localhost:5432/quarry_metadata

WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=quarry_admin
WAREHOUSE_PASSWORD=quarry_dev_password
WAREHOUSE_DB=quarry_metadata
WAREHOUSE_SCHEMA=analytics

# ---------------------------------------------------------------------------
# Host ports published by docker-compose. Override if another local project
# already binds these (e.g. another Postgres on 5432).
# ---------------------------------------------------------------------------
POSTGRES_PORT=5432
METADATA_API_PORT=8000
AIRFLOW_PORT=8080

# ---------------------------------------------------------------------------
# Data lake zones. Local filesystem paths by default; point at s3:// URIs
# (with AWS credentials below) to run the same DAG against real S3.
# ---------------------------------------------------------------------------
RAW_ZONE_PATH=./data-lake/raw
CLEAN_ZONE_PATH=./data-lake/clean
CURATED_ZONE_PATH=./data-lake/curated
SALES_ORDERS_SOURCE_CSV=./sample-data/sales_orders.csv
SALES_ORDERS_NULL_RATE_THRESHOLD=0.10

# ---------------------------------------------------------------------------
# dbt
# ---------------------------------------------------------------------------
DBT_PROFILES_DIR=./dbt

# ---------------------------------------------------------------------------
# AWS (only required once pointing at real S3/Glue/Redshift, not for the
# local docker-compose dev loop)
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_PROFILE=quarry-dev
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Redshift (real serving warehouse; unused while WAREHOUSE_* points at
# local Postgres)
# ---------------------------------------------------------------------------
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_DB=quarry
REDSHIFT_SCHEMA=analytics
